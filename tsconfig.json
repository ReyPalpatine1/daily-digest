{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // scripts/ 는 개발자용 도구라 앱 빌드 대상이 아니다(배포 번들·타입체크에서 제외).
  // npm run check:i18n 이 tsc CLI에 파일을 직접 넘겨 따로 컴파일한다.
  // .tmp-i18n 은 그 컴파일 산출물 폴더.
  "exclude": ["node_modules", "scripts", ".tmp-i18n"]
}
