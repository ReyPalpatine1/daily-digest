{
  // check:i18n 전용 컴파일 설정.
  // ★ tsc에 파일을 커맨드라인으로 넘기지 않고 이 프로젝트 파일로 컴파일한다.
  //   커맨드라인에 파일을 지정하면 TypeScript 버전에 따라
  //   "TS5112: tsconfig.json is present but will not be loaded if files are specified
  //   on commandline" 로 컴파일이 실패해, 검사가 아예 실행되지 않는 환경이 생긴다.
  // ★ noEmitOnError: 컴파일 실패 시 산출물을 남기지 않는다 —
  //   낡은 .tmp-i18n 산출물이 남아 옛 결과가 다시 실행되는 것을 막는다.
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": "..",
    "outDir": "../.tmp-i18n"
  },
  "include": ["check-i18n.ts"]
}
