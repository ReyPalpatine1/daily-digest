{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "daily-digest",
	// 배포 시 대시보드에 등록된 일반 환경변수를 Wrangler가 덮어써서 지우지 않도록 보존.
	// (Secret은 원래 보존되지만 일반 변수는 기본적으로 매 배포마다 덮어쓰여 사라짐)
	"keep_vars": true,
	// 커스텀 워커 엔트리(fetch는 .open-next/worker.js에 위임 + scheduled 추가).
	// cf:build(opennextjs-cloudflare build)는 main과 무관하게 .open-next/worker.js를 생성한다.
	"main": "worker.ts",
	// Cloudflare Cron Triggers — 기존 GitHub Actions와 동일 주기(15분). scheduled가 collect→cron 호출.
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"compatibility_date": "2025-12-19",
	// Node API 사용을 위해 필요
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "nodejs_compat_populate_process_env"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// OpenNext R2 증분 캐시 (ISR/데이터 캐시 저장소)
	// binding 이름은 R2 캐시 오버라이드가 기대하는 표준 이름이어야 함.
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "daily-digest-cache"
		}
	],
	// ISR 온디맨드 재검증(revalidate)에 필요한 self-reference 서비스 바인딩.
	// service 값은 위 worker name과 동일해야 함.
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "daily-digest"
		}
	],
	// 실시간 로그를 매번 수동으로 켜지 않아도 자동 수집되도록 항상 활성화.
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}
